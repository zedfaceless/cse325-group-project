<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">cse325-group-project</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <AuthorizeView Roles="Teacher">
<div class="nav-item px-3">
            <NavLink class="nav-link" href="courses">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Courses
            </NavLink>
        </div>
</AuthorizeView>

        <AuthorizeView Roles="Teacher">
<div class="nav-item px-3">
            <NavLink class="nav-link" href="sessions">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Sessions
            </NavLink>
        </div>
</AuthorizeView>

        <AuthorizeView Roles="Teacher">
<div class="nav-item px-3">
            <NavLink class="nav-link" href="attendance">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Attendance
            </NavLink>
        </div>
</AuthorizeView>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="materials">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Materials
            </NavLink>
        </div>
    
        <div class="nav-item px-3">
            <AuthorizeView>
                <Authorized>
                    <span class="nav-link">Hello, @context.User.Identity?.Name</span>
                    <form action="Identity/Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="returnUrl" value="/" />
                        <button type="submit" class="nav-link btn btn-link">Logout</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <NavLink class="nav-link" href="Identity/Account/Register">Register</NavLink>
                    <NavLink class="nav-link" href="Identity/Account/Login">Login</NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </div>
</nav>
</div>