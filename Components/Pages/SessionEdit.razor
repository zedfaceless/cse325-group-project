@page "/sessions/edit/{Id:int}"
@attribute [Authorize(Roles = "Teacher")]
@rendermode InteractiveServer
@using cse325_group_project.Models
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@inject cse325_group_project.Data.ApplicationDbContext Db
@inject NavigationManager Nav

<PageTitle>Edit Session</PageTitle>
<h1>Edit Session</h1>

@if (session is null)
{
    <div class="alert alert-warning" role="alert">Session not found.</div>
}
else
{
    @if (errorMessage is not null)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <EditForm Model="session" OnValidSubmit="HandleValidSubmit" FormName="edit-session">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label" for="course">Course</label>
            <InputSelect id="course" class="form-select" @bind-Value="session.CourseId">
                <option value="0">Select a course</option>
                @foreach (var course in courses)
                {
                    <option value="@course.Id">@course.Name</option>
                }
            </InputSelect>
        </div>

        <div class="mb-3">
            <label class="form-label">Date</label>
            <InputDate class="form-control" @bind-Value="session.Date" />
        </div>

        <div class="mb-3">
            <label class="form-label">Topic</label>
            <InputText class="form-control" @bind-Value="session.Topic" />
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
    </EditForm>
}

@code {
    [Parameter] public int Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private Session? session;
    private List<Course> courses = new();
    private string teacherId = string.Empty;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        var auth = await AuthState!;
        teacherId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        courses = await Db.Courses
            .AsNoTracking()
            .Where(course => course.TeacherId == teacherId)
            .OrderBy(course => course.Name)
            .ToListAsync();
        session = await Db.Sessions
            .Include(s => s.Course)
            .SingleOrDefaultAsync(s => s.Id == Id && s.Course!.TeacherId == teacherId);
    }

    private async Task HandleValidSubmit()
    {
        if (session is null)
        {
            return;
        }

        var ownsCourse = await Db.Courses.AnyAsync(course =>
            course.Id == session.CourseId && course.TeacherId == teacherId);
        if (!ownsCourse)
        {
            errorMessage = "The selected course is not available.";
            return;
        }

        await Db.SaveChangesAsync();
        Nav.NavigateTo("/sessions");
    }
}
