@page "/sessions"
@attribute [Authorize(Roles = "Teacher")]
@rendermode InteractiveServer
@using cse325_group_project.Models
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@inject cse325_group_project.Data.ApplicationDbContext Db

<PageTitle>Sessions</PageTitle>
<h1>Sessions</h1>

<a href="/sessions/create" class="btn btn-primary mb-3">+ New Session</a>

@if (sessions is null)
{
    <p>Loading...</p>
}
else if (!sessions.Any())
{
    <p>No sessions yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Course</th>
                <th>Date</th>
                <th>Topic</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in sessions)
            {
                <tr>
                    <td>@s.Course?.Name</td>
                    <td>@s.Date.ToShortDateString()</td>
                    <td>@s.Topic</td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" href="/sessions/edit/@s.Id">Edit</a>
                        <a class="btn btn-sm btn-outline-secondary ms-1" href="/attendance/@s.Id">Attendance</a>
                        <button class="btn btn-link text-danger" @onclick="() => Delete(s.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<Session>? sessions;
    private string teacherId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState!;
        teacherId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        await LoadSessions();
    }

    private async Task LoadSessions()
    {
        sessions = await Db.Sessions
            .AsNoTracking()
            .Include(s => s.Course)
            .Where(s => s.Course!.TeacherId == teacherId)
            .OrderBy(s => s.Date)
            .ToListAsync();
    }

    private async Task Delete(int id)
    {
        var session = await Db.Sessions
            .Include(s => s.Course)
            .SingleOrDefaultAsync(s => s.Id == id && s.Course!.TeacherId == teacherId);
        if (session is not null)
        {
            Db.Sessions.Remove(session);
            await Db.SaveChangesAsync();
            await LoadSessions();
        }
    }
}
