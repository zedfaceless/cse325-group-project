@page "/sessions/create"
@attribute [Authorize(Roles = "Teacher")]
@rendermode InteractiveServer
@using cse325_group_project.Models
@using Microsoft.EntityFrameworkCore
@inject cse325_group_project.Data.ApplicationDbContext Db
@inject NavigationManager Nav

<PageTitle>Create Session</PageTitle>
<h1>Create Session</h1>

<EditForm Model="session" OnValidSubmit="HandleValidSubmit" FormName="create-session">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Course</label>
        <InputSelect class="form-select" @bind-Value="session.CourseId">
            @foreach (var course in courses)
            {
                <option value="@course.Id">Course #@course.Id</option>
            }
        </InputSelect>
    </div>

    <div class="mb-3">
        <label class="form-label">Date</label>
        <InputDate class="form-control" @bind-Value="session.Date" />
    </div>

    <div class="mb-3">
        <label class="form-label">Topic</label>
        <InputText class="form-control" @bind-Value="session.Topic" />
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
</EditForm>

@code {
    private Session session = new();
    private List<Course> courses = new();

    protected override async Task OnInitializedAsync()
    {
        courses = await Db.Courses.ToListAsync();
    }

    private async Task HandleValidSubmit()
    {
        Db.Sessions.Add(session);
        await Db.SaveChangesAsync();
        Nav.NavigateTo("/sessions");
    }
}
