@page "/my-attendance"
@attribute [Authorize(Roles = "Student")]
@rendermode InteractiveServer
@using System.Security.Claims
@using cse325_group_project.Data
@using cse325_group_project.Models
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db

<PageTitle>My Attendance</PageTitle>
<h1>My Attendance</h1>
<p class="text-muted">Your classes, when they start, and your attendance so far.</p>

@if (loading)
{
    <p>Loading your classes...</p>
}
else if (!courses.Any())
{
    <div class="alert alert-info" role="status">
        You are not enrolled in any course yet. <a href="/course-catalog">Browse the course catalog</a> to pick one.
    </div>
}
else
{
    @foreach (var course in courses)
    {
        <div class="card mb-4" style="max-width: 720px;">
            <div class="card-body">
                <h5 class="card-title mb-1">@course.CourseName</h5>
                <p class="card-text mb-1"><small class="text-muted">Teacher: @course.TeacherName</small></p>
                <p class="card-text mb-1"><small class="text-muted">@course.ScheduleLine</small></p>
                @if (course.StartDate != default)
                {
                    <p class="card-text mb-0"><small class="text-muted">Starts @course.StartDate.ToString("D")</small></p>
                }

                @if (course.Sessions.Any())
                {
                    <div class="table-responsive mt-3">
                        <table class="table table-sm align-middle mb-0">
                            <thead><tr><th>Class date</th><th>Status</th></tr></thead>
                            <tbody>
                                @foreach (var session in course.Sessions)
                                {
                                    <tr class="@(session.IsNext ? "table-primary" : null)">
                                        <td>@session.Date.ToString("ddd, MMM d, yyyy")</td>
                                        <td>
                                            @if (session.Attendance is bool present)
                                            {
                                                <span class="badge @(present ? "bg-success" : "bg-danger")">@(present ? "Present" : "Absent")</span>
                                            }
                                            else if (session.Date < today)
                                            {
                                                <span class="text-muted">Not recorded</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">@(session.IsNext ? "Next class" : "Upcoming")</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-light border mt-3 mb-0" role="status">Schedule to be announced.</div>
                }
            </div>
        </div>
    }
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private bool loading = true;
    private DateOnly today;
    private List<CourseView> courses = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState!;
        var studentId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);
        today = DateOnly.FromDateTime(DateTime.Now);

        if (string.IsNullOrWhiteSpace(studentId))
        {
            loading = false;
            return;
        }

        var enrolled = await (
            from enrollment in Db.Enrollments.AsNoTracking()
            join course in Db.Courses.AsNoTracking() on enrollment.CourseId equals course.Id
            join teacher in Db.Users.AsNoTracking() on course.TeacherId equals teacher.Id
            where enrollment.StudentId == studentId
            select new
            {
                course.Id,
                course.Name,
                TeacherName = teacher.FullName ?? teacher.Email!,
                course.ScheduleDays,
                course.StartTime,
                course.SessionsPerWeek,
                course.MinutesPerSession,
                course.Weeks,
                course.StartDate
            })
            .OrderBy(c => c.Name)
            .ToListAsync();

        // This student's recorded attendance, keyed by course + session date so the
        // calendar can mark each generated class date without needing Session rows.
        var recorded = (await Db.Attendances.AsNoTracking()
            .Where(a => a.StudentId == studentId)
            .Select(a => new { a.Session!.CourseId, a.Session!.Date, a.IsPresent })
            .ToListAsync())
            .GroupBy(a => (a.CourseId, DateOnly.FromDateTime(a.Date)))
            .ToDictionary(g => g.Key, g => g.First().IsPresent);

        courses = enrolled.Select(c =>
        {
            var sessions = SemesterCalendar.ClassDates(c.ScheduleDays, c.StartDate, c.SessionsPerWeek, c.Weeks)
                .Select(date => new ClassDateView
                {
                    Date = date,
                    Attendance = recorded.TryGetValue((c.Id, date), out var present) ? present : null
                })
                .ToList();

            var next = sessions.FirstOrDefault(s => s.Date >= today);
            if (next is not null)
            {
                next.IsNext = true;
            }

            return new CourseView
            {
                CourseName = c.Name,
                TeacherName = c.TeacherName,
                ScheduleLine = ScheduleFormatting.Format(c.ScheduleDays, c.StartTime, c.SessionsPerWeek, c.MinutesPerSession, c.Weeks),
                StartDate = c.StartDate,
                Sessions = sessions
            };
        })
        .ToList();

        loading = false;
    }

    private sealed class CourseView
    {
        public string CourseName { get; init; } = string.Empty;
        public string TeacherName { get; init; } = string.Empty;
        public string ScheduleLine { get; init; } = string.Empty;
        public DateOnly StartDate { get; init; }
        public List<ClassDateView> Sessions { get; init; } = new();
    }

    private sealed class ClassDateView
    {
        public DateOnly Date { get; init; }
        // null = no attendance recorded for this class date yet
        public bool? Attendance { get; init; }
        public bool IsNext { get; set; }
    }
}
