@page "/courses"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Teacher")]
@inject ApplicationDbContext Db
@using cse325_group_project.Data
@using cse325_group_project.Models
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims

<PageTitle>My Courses</PageTitle>

<h1>My Courses</h1>

@* ---- Create / Edit form. EditForm + DataAnnotationsValidator = the W04 module's
      form stack: validation comes from the attributes on the Course model. ---- *@
<div class="card p-3 mb-4" style="max-width: 640px;">
    <h5>@(editing is null ? "Add a course" : $"Edit: {editing.Name}")</h5>
    <EditForm Model="form" OnValidSubmit="Save" FormName="courseForm">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />

        <div class="mb-2">
            <label class="form-label">Course name</label>
            <InputText class="form-control" @bind-Value="form.Name" />
        </div>
        <div class="mb-2">
            <label class="form-label">Description</label>
            <InputTextArea class="form-control" @bind-Value="form.Description" />
        </div>

        <hr class="my-3" />
        <h6 class="text-muted">Schedule</h6>

        <div class="mb-2">
            <label class="form-label">Class format</label>
            <InputSelect class="form-select" @bind-Value="format">
                <option value="1">Once a week — 90-minute classes</option>
                <option value="2">Twice a week — 45-minute classes</option>
            </InputSelect>
        </div>

        <div class="row">
            <div class="col-sm-6 mb-2">
                <label class="form-label">Meets on</label>
                <InputSelect class="form-select" @bind-Value="day1">
                    @foreach (var day in Days)
                    {
                        <option value="@day">@day</option>
                    }
                </InputSelect>
            </div>
            @if (format == "2")
            {
                <div class="col-sm-6 mb-2">
                    <label class="form-label">Second day</label>
                    <InputSelect class="form-select" @bind-Value="day2">
                        @foreach (var day in Days.Where(d => d != day1))
                        {
                            <option value="@day">@day</option>
                        }
                    </InputSelect>
                </div>
            }
        </div>

        <div class="row">
            <div class="col-sm-6 mb-2">
                <label class="form-label">Starts at</label>
                <input type="time" class="form-control" value="@startTimeText"
                       @onchange="(ChangeEventArgs e) => startTimeText = e.Value?.ToString() ?? startTimeText" />
            </div>
            <div class="col-sm-6 mb-2">
                <label class="form-label">Weeks of lessons</label>
                <input type="number" class="form-control" min="1" max="30" @bind="weeks" />
            </div>
        </div>

        @if (error is not null)
        {
            <div class="alert alert-danger py-2 mt-2" role="alert">@error</div>
        }

        <div>
            <button type="submit" class="btn btn-primary">@(editing is null ? "Create" : "Save changes")</button>
            @if (editing is not null)
            {
                <button type="button" class="btn btn-secondary ms-2" @onclick="CancelEdit">Cancel</button>
            }
        </div>
    </EditForm>
</div>

@* ---- Course list ---- *@
@if (courses.Count == 0)
{
    <p>No courses yet — create your first one above.</p>
}
else
{
    <table class="table" style="max-width: 900px;">
        <thead>
            <tr><th>Name</th><th>Description</th><th>Schedule</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var course in courses)
            {
                <tr>
                    <td>@course.Name</td>
                    <td>@course.Description</td>
                    <td class="text-nowrap">@ScheduleFormatting.Format(course)</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => StartEdit(course)">Edit</button>
                        <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => Delete(course)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    // The logged-in teacher's Identity user id, read from the auth state your Card 1 provides.
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private string teacherId = string.Empty;

    private static readonly string[] Days =
        { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" };

    private List<Course> courses = new();
    private Course form = new();       // the object the EditForm binds to
    private Course? editing = null;    // null = creating, otherwise the course being edited

    // Schedule inputs. "1"/"2" keeps InputSelect binding string-simple.
    private string format = "1";
    private string day1 = "Tuesday";
    private string day2 = "Thursday";
    private string startTimeText = "19:00";
    private int weeks = 14;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState!;
        teacherId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        await LoadCourses();
    }

    private async Task LoadCourses()
    {
        // Teachers only ever see and manage their OWN courses.
        courses = await Db.Courses.Where(c => c.TeacherId == teacherId)
                                  .OrderBy(c => c.Name)
                                  .ToListAsync();
    }

    private async Task Save()
    {
        error = null;

        if (!TimeOnly.TryParse(startTimeText, out var start))
        {
            error = "Enter a valid start time.";
            return;
        }
        if (weeks < 1 || weeks > 30)
        {
            error = "Weeks of lessons must be between 1 and 30.";
            return;
        }

        // Map the schedule inputs onto the course before saving.
        form.ScheduleDays = format == "2" ? $"{day1}, {day2}" : day1;
        form.StartTime = start;
        form.SessionsPerWeek = format == "2" ? 2 : 1;
        form.MinutesPerSession = format == "2" ? 45 : 90;
        form.Weeks = weeks;

        if (editing is null)
        {
            form.TeacherId = teacherId;   // ownership set server-side, never from user input
            Db.Courses.Add(form);
        }
        else
        {
            editing.Name = form.Name;
            editing.Description = form.Description;
            editing.ScheduleDays = form.ScheduleDays;
            editing.StartTime = form.StartTime;
            editing.SessionsPerWeek = form.SessionsPerWeek;
            editing.MinutesPerSession = form.MinutesPerSession;
            editing.Weeks = form.Weeks;
        }
        await Db.SaveChangesAsync();
        form = new();
        editing = null;
        await LoadCourses();
    }

    private void StartEdit(Course course)
    {
        editing = course;
        form = new Course { Name = course.Name, Description = course.Description };

        var days = course.ScheduleDays
            .Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
        day1 = days.Length > 0 ? days[0] : "Tuesday";
        day2 = days.Length > 1 ? days[1] : "Thursday";
        format = course.SessionsPerWeek == 2 ? "2" : "1";
        startTimeText = course.StartTime.ToString("HH:mm");
        weeks = course.Weeks > 0 ? course.Weeks : 14;
        error = null;
    }

    private void CancelEdit()
    {
        editing = null;
        form = new();
        error = null;
    }

    private async Task Delete(Course course)
    {
        Db.Courses.Remove(course);
        await Db.SaveChangesAsync();
        await LoadCourses();
    }
}
